// Draft (planned, not implemented). The final manifest is plain JSON without comments.
// The variant build permission and the run settings schema are open until Uzume 0.21 defines them (ADR 0031 D5).
{
  "id": "uzume.randomizer",                // plugin id (open: confirm with the Uzume plugin index)
  "name": "Randomizer",                    // display name
  "version": "0.1.0",
  "api": 1,
  "type": "script",
  "games": [
    { "system": "gb" }, { "system": "gbc" }, { "system": "gba" },
    { "system": "nds" }, { "system": "3ds" }
  ],                                       // narrowed to supported game codes per preset table (open)
  "permissions": ["ui"],                   // plus the variant build permission (name open)
  "entry": "main.lua",
  "assets": ["i18n/"],
  "run_settings": { }                      // mode, preset, allow own variants (schema open)
}
